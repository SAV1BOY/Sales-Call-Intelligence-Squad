# ============================================================
# SWIPE CONFIG — Sales Call Intelligence Squad
# Configuração de swipe files e fontes curadas
# ============================================================

swipe:
  name: sales-call-intelligence-swipe
  description: "Biblioteca de exemplos reais de calls, rewrites, scorecards e coaching"

  # Categorias de swipe files
  categories:
    best-calls:
      path: swipe/best-calls/
      description: "Calls exemplares por categoria"
      files:
        - best-discovery-calls.md
        - best-objection-handling-calls.md
        - best-price-reveals.md
        - best-closes.md
        - best-turnaround-calls.md

    worst-calls:
      path: swipe/worst-calls/
      description: "Anti-padrões e erros para aprender"
      files:
        - worst-discovery-calls.md
        - worst-price-reveals.md
        - worst-closes.md
        - worst-objection-handling.md

    best-rewrites:
      path: swipe/best-rewrites/
      description: "Melhores reescritas de momentos críticos"
      files:
        - best-objection-rewrites.md
        - best-pitch-rewrites.md
        - best-close-rewrites.md

    best-scorecards:
      path: swipe/best-scorecards/
      description: "Exemplos de scorecards de alta e turnaround"
      files:
        - high-score-examples.md
        - turnaround-score-examples.md

    best-coaching-packs:
      path: swipe/best-coaching-packs/
      description: "Packs de coaching que geraram melhoria real"
      files:
        - effective-coaching-examples.md
        - certification-examples.md

  # Fontes curadas
  sources:
    path: swipe-sources/
    description: "Índices de conteúdo por especialista e fonte"
    files:
      - hormozi-content-index.md
      - cole-gordon-content-index.md
      - miner-content-index.md
      - belfort-content-index.md
      - sabri-suby-content-index.md
      - sales-podcast-index.md
      - linkedin-sales-leaders-index.md
      - evelyn-framework-transcriptions.md

  # Regras de curadoria
  curation:
    min_score_for_best: 80          # Score mínimo para entrar em best-calls
    max_score_for_worst: 40         # Score máximo para entrar em worst-calls
    rewrite_requires_evidence: true # Reescrita precisa ter trecho original
    coaching_requires_outcome: true # Coaching precisa mostrar resultado
    update_frequency: weekly        # Frequência de atualização
